LLM_SM_IMAGE=infocyph/llm-sm:latest
LLM_SM_AMD_IMAGE=infocyph/llm-sm:amd-latest
LLM_SM_VOLUME=llm-sm-data
LLM_SM_WORKSPACE=.
LLM_SM_WORKSPACE_MODE=ro
LLM_SM_INPUT_WARN_BYTES=65536
LLM_SM_INPUT_MAX_BYTES=262144
LLM_SM_ALLOW_LARGE_INPUT=0
OLLAMA_PORT=11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NO_CLOUD=1
