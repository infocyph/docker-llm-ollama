#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ENTRYPOINT="$SCRIPT_DIR/$(basename -- "${BASH_SOURCE[0]}")"

if [[ -f "$SCRIPT_DIR/lib/core.sh" && -d "$SCRIPT_DIR/commands" ]]; then
  RUNTIME_ROOT="$SCRIPT_DIR"
else
  PREFIX="$(cd -- "$SCRIPT_DIR/.." && pwd)"
  RUNTIME_ROOT="$PREFIX/lib/llm-sm"
fi

for required in \
  "$RUNTIME_ROOT/lib/core.sh" \
  "$RUNTIME_ROOT/lib/docker.sh" \
  "$RUNTIME_ROOT/lib/ollama.sh"; do
  if [[ ! -f "$required" ]]; then
    printf 'Error: llm-sm runtime file not found: %s\n' "$required" >&2
    exit 1
  fi
done

export LLM_SM_ENTRYPOINT="$ENTRYPOINT"
export LLM_SM_RUNTIME_ROOT="$RUNTIME_ROOT"

# shellcheck source=/dev/null
source "$RUNTIME_ROOT/lib/core.sh"
# shellcheck source=/dev/null
source "$RUNTIME_ROOT/lib/docker.sh"
# shellcheck source=/dev/null
source "$RUNTIME_ROOT/lib/ollama.sh"

command="${1:-help}"
[[ $# -eq 0 ]] || shift

case "$command" in
  -h|--help) command="help" ;;
  -v|--version) command="version" ;;
  list) command="models" ;;
  remove) command="rm" ;;
esac

[[ "$command" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "Invalid command: $command"

command_file="$RUNTIME_ROOT/commands/$command.sh"
[[ -f "$command_file" ]] || die "Unknown command: $command. Run 'llm-sm help'."

# shellcheck source=/dev/null
source "$command_file"
declare -F command_main >/dev/null 2>&1 || die "Command module is invalid: $command"

command_main "$@"
